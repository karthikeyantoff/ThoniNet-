{
  "expo": {
    "name": "ThoniNet",
    "slug": "thoninet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F17"
    },
    "android": {
      "package": "org.keralawaterways.thoninet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F17"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ThoniNet to access your location to calculate distance to nearest SWTD jetties."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ThoniNet to access photos to upload vessel inspection certificates."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ThoniNet to access camera to scan and verify physical KIV boat QR codes."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow ThoniNet to access microphone to process Malayalam Sarvam AI voice commands."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a19dda7-5c2c-4a55-9b6a-36609614310f"
      }
    },
    "owner": "karthikeyantoff44"
  }
}